# Public values only — anything prefixed EXPO_PUBLIC_ is bundled into the app.
# Leave empty to run in PREVIEW MODE (no sign-in; data kept on this device).
#
# Use the same project as the web app. For local Supabase on your PC, a phone
# can't reach 127.0.0.1 — use your computer's LAN address instead, e.g.
# http://192.168.1.20:54321
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
