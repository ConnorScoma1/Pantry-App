{
  "expo": {
    "name": "Kitchen Pantry",
    "slug": "kitchen-pantry",
    "scheme": "kitchenpantry",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kitchenpantry.app"
    },
    "android": {
      "package": "com.kitchenpantry.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Kitchen Pantry uses the camera to scan product barcodes and photograph grocery receipts.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kitchen Pantry reads a receipt photo you choose to add the groceries to your kitchen. The photo isn't kept.",
          "cameraPermission": "Kitchen Pantry uses the camera to photograph grocery receipts.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
