# Copy to .env.local and fill in. Leave the Supabase values empty to run the
# web app in local PREVIEW MODE (no sign-in, data kept in this browser only).

# From `npx supabase start` (local) or Project Settings → API (hosted).
NEXT_PUBLIC_SUPABASE_URL=
# The anon / publishable key. Safe for the browser — RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build auth redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never prefix with NEXT_PUBLIC_. Used from Phase 3 (AI meal planning).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_MAX_OUTPUT_TOKENS=2048
