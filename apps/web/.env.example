# Copy to .env.local and fill in. Leave the Supabase values empty to run the
# web app in local PREVIEW MODE (no sign-in, data kept in this browser only).

# From `npx supabase start` (local) or Project Settings → API (hosted).
NEXT_PUBLIC_SUPABASE_URL=
# The anon / publishable key. Safe for the browser — RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build auth redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on /privacy and /delete-account (set before launch)
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only AI (meal plans, recipe adaptations, substitutions, cooking help).
# Never prefix with NEXT_PUBLIC_. Leave every key empty to use the app's
# built-in features only. README → "AI setup" and docs/AI_COSTS.md.
#   AI_PROVIDER — gemini | anthropic | openai | groq (default: whichever key is set)
#   AI_MODEL    — gemini defaults to gemini-3.1-flash-lite; openai/groq need one
AI_PROVIDER=
AI_MODEL=
# Google: a Gemini API key from AI Studio (starts AIza… or AQ.…). The app uses
# Google AI Studio; set GEMINI_ENDPOINT=vertex only for Vertex AI (needs Cloud billing).
GEMINI_API_KEY=
# Optional, Gemini 3 only: minimal | low | medium | high (thinking is billed as output).
GEMINI_THINKING_LEVEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
GROQ_API_KEY=
# Price per million tokens, from the provider's pricing page. Needed for cost
# estimates and the budget below unless the model's price is built in
# (gemini-3.1-flash-lite: $0.25 in / $1.50 out, checked 2026-11-02).
AI_PRICE_INPUT_PER_M=
AI_PRICE_OUTPUT_PER_M=
# Spending cap for the whole app per calendar month, US dollars (estimated
# from tokens × price). When reached, AI switches off until next month and
# the app's normal features carry on. Needs migration …2300_ai_costs.
AI_MONTHLY_BUDGET_USD=
# AI requests per person per calendar month, all features together.
AI_MONTHLY_REQUESTS_PER_PERSON=
AI_MAX_OUTPUT_TOKENS=2048
# AI meal plans per household per 24 hours (0 turns AI planning off).
AI_DAILY_PLAN_LIMIT=10

# Server-only. Live store prices from Kroger-family stores (Kroger, Ralphs,
# Fred Meyer, King Soopers, Harris Teeter, Pick 'n Save, Mariano's…).
# Register an app at https://developer.kroger.com (Production environment,
# Products + Locations), then paste its client ID and secret here.
# Leave empty and the grocery list shows no prices (never estimates).
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# How long a product search is reused before asking Kroger again (minutes, max 360).
PRICING_CACHE_MINUTES=30
# Price checks per person per hour (protects the app's shared daily Kroger quota).
PRICING_HOURLY_LIMIT=30

# Server-only. Smart Cart → Kroger cart (Kroger Public Cart API). OFF until all
# of these are set AND your Kroger app has the Cart API added in the portal:
#   KROGER_REDIRECT_URI  — exactly as registered on the Kroger app, e.g.
#                          https://your-site.example/api/retailers/kroger/callback
#   RETAILER_TOKEN_KEY   — 32 random bytes, base64 (openssl rand -base64 32).
#                          Seals Kroger sign-in tokens before they're stored.
#   SUPABASE_SERVICE_ROLE_KEY — Project Settings → API. Server only, never
#                          NEXT_PUBLIC_. Used only to start/finish real sends
#                          and to read/write the sealed tokens.
#   SMART_CART_KROGER=on — the switch. Leave off to use the practice retailer only.
SUPABASE_SERVICE_ROLE_KEY=
KROGER_REDIRECT_URI=
RETAILER_TOKEN_KEY=
SMART_CART_KROGER=off

# Server-only. Weekly drafts (Plan → Planning settings → Weekly drafts). OFF
# until all of these are set AND something calls /api/jobs/weekly-drafts every
# hour (README → "Weekly drafts"). Households still choose to turn it on.
#   WEEKLY_DRAFTS=on      — the switch.
#   CRON_SECRET           — at least 32 random characters (openssl rand -hex 32).
#                           The scheduler sends "Authorization: Bearer <CRON_SECRET>".
#   SUPABASE_SERVICE_ROLE_KEY (above) — the database only lets the server claim,
#                           read inputs for and finish drafting jobs.
#   WEEKLY_DRAFTS_PER_RUN — households drafted per call (default 10, max 50).
#   EXPO_ACCESS_TOKEN     — optional; only if "enhanced push security" is on in
#                           your Expo account (phone notifications).
WEEKLY_DRAFTS=off
CRON_SECRET=
WEEKLY_DRAFTS_PER_RUN=10
EXPO_ACCESS_TOKEN=

# Server-only. Use-soon reminders (Profile → Reminders): once a day, in each
# person's daytime, what in their kitchen is due today or tomorrow. OFF until
# USE_SOON_REMINDERS=on, CRON_SECRET and SUPABASE_SERVICE_ROLE_KEY (above) are
# set AND something calls /api/jobs/use-soon every hour (README → "Use-soon
# reminders"). Phone notifications use EXPO_ACCESS_TOKEN above, if set.
#   USE_SOON_PER_RUN — people reminded per call (default 500, max 5000).
USE_SOON_REMINDERS=off
USE_SOON_PER_RUN=500

# Server-only. Cooking assistant questions per household per 24 hours
# (default 30; 0 = built-in help only). Uses ANTHROPIC_API_KEY above.
AI_DAILY_HELP_LIMIT=30

# Server-only. AI recipe versions (simpler / budget / elevated / traditional)
# and full recipes for dish ideas, per household per 24 hours (default 5).
AI_DAILY_DRAFT_LIMIT=5

# Server-only. AI shopping-advisor explanations of a store comparison, per
# household per 24 hours (default 10; 0 = the app's own wording only).
AI_DAILY_ADVICE_LIMIT=10

# Server-only. Receipt photos read by the AI assistant per household per 24
# hours (default 5; 0 = receipts off). Photos are never stored.
AI_DAILY_RECEIPT_LIMIT=5

# Barcode lookups (Open Food Facts, free, no key). They ask every app to
# identify itself with a contact: "KitchenPantry/0.1 (you@your-domain.example)".
OPEN_FOOD_FACTS_USER_AGENT=

# Server-only. One Store vs. Best Deals drive times (Mapbox Matrix + Geocoding).
# Create a token at https://account.mapbox.com (default public scopes are
# enough) and restrict it to your server's use. Empty = comparisons show
# grocery totals only — fuel and travel time are never estimated without it.
# The starting point is geocoded per comparison ("temporary" geocoding) and
# never stored.
MAPBOX_ACCESS_TOKEN=
# Signs the comparison the AI advisor explains, so a client can't hand it
# made-up numbers. Any long random string (e.g. openssl rand -hex 32). Needed
# when the web app runs on more than one server instance.
SHOPPING_ADVICE_SECRET=

# Server-only. Preview mode (no Supabase) has no accounts, so AI planning and
# the cooking assistant are off there in production unless this is "on".
# Local development (npm run dev) doesn't need it. Leave unset when deployed.
AI_IN_PREVIEW=

# Server-only, optional. Email household invites from the server (Resend).
# INVITE_EMAIL_FROM must be on a domain you've verified with Resend, e.g.
# "Kitchen Pantry <invites@your-domain.example>". Needs NEXT_PUBLIC_SITE_URL
# on https. Empty = "Email it" opens the person's own mail app instead.
RESEND_API_KEY=
INVITE_EMAIL_FROM=
