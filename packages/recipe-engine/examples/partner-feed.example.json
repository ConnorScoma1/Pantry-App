      "title": "Turkish Red Lentil Soup (Mercimek Çorbası)",
      "description": "A silky red lentil soup with cumin, paprika butter and lemon.",
      "cuisine": "turkish",
      "authenticity": "traditional",
      "course": "main",
      "skillLevel": 1,
      "prepMinutes": 10,
      "cookMinutes": 35,
      "servings": 4,
      "equipment": ["stove", "blender"],
      "ingredients": [
        { "quantity": "1 1/2", "unit": "cups", "item": "red lentils", "preparation": "rinsed" },
        { "quantity": 1, "unit": null, "item": "onion", "preparation": "chopped" },
        { "quantity": 6, "unit": "cups", "item": "vegetable stock" },
        { "quantity": 1, "unit": "tsp", "item": "ground cumin" },
        { "quantity": 2, "unit": "tbsp", "item": "butter" },
        { "quantity": 1, "unit": "tsp", "item": "Aleppo pepper" }
      ],
      "steps": [
        { "body": "Soften the onion in a little of the butter, then add the lentils, cumin and stock.", "minutes": 5 },
        { "body": "Simmer until the lentils collapse, about 25 minutes, then blend until smooth.", "minutes": 25 },
        { "body": "Melt the rest of the butter with the Aleppo pepper and drizzle over each bowl with a squeeze of lemon." }
      ]
    },
